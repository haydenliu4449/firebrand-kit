# Settings for scripts/0*.sh. Copy this file to .env and check the values:
#
#     cp .env.example .env
#
# Same variables as the lab's gcp-example, plus a few firebrand ones at the
# bottom. Nothing here is secret.

# ---- Google Cloud (CHECK THESE) -------------------------------------------
# The lab's project, from berkeley-firelab/gcp-example. Use your own project ID
# instead if you are running under a personal account.
PROJECT_ID=berkeley-fire-lab
# Bucket, or bucket/folder, that holds clips/, masks/ and work/. No gs:// needed.
# Bucket names are global across all of Google Cloud; 00-setup.sh creates it
# if it does not exist and tells you if the name is taken.
BUCKET_PATH=berkeley-fire-lab-firebrands
# Region for the bucket, the image registry and the jobs. Keep all three in one
# region: reading the bucket from a job in the same region is free.
LOCATION=us-central1
ARTIFACT_REPOSITORY=firebrand
IMAGE_NAME=firebrand
IMAGE_TAG=latest

# ---- machines ----------------------------------------------------------------
# GPU steps (smoke, train, tag). g2-standard-4 + 1x L4 is what the lab template
# uses: ~$0.71/hour on demand in us-central1, billed only while a job runs.
GPU_MACHINE=g2-standard-4
GPU_TYPE=nvidia-l4
# CPU steps (detect, tiles). Detection is OpenCV on the CPU; a GPU would idle.
CPU_MACHINE=n2-standard-4
# STANDARD, or SPOT for a much lower price with the risk of being interrupted.
# Every step resumes after an interruption and preempted tasks are retried
# automatically, so SPOT is safe -- it can just take longer to get a machine.
PROVISIONING=STANDARD
# How many machines one job may use at once. detect and tag give each clip its
# own task. GPU_PARALLEL above 1 needs a GPU quota above 1 in LOCATION.
CPU_PARALLEL=4
GPU_PARALLEL=1

# ---- firebrand ---------------------------------------------------------------
# Mask file inside <bucket>/masks/ (uploaded from masks/ by 03-upload_inputs.sh)
MASK=left_front.json
